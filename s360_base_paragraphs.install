<?php

/**
 * @file
 * Install, update and uninstall functions for s360_base_paragraphs.
 */

declare(strict_types=1);

/**
 * Regenerate paragraph type icons whose files are missing from disk.
 */
function s360_base_paragraphs_update_11001(): string {
  $result = \Drupal::service('s360_base_paragraphs.paragraphs_icon_repair')->repair();

  return t('Paragraph type icons: @repaired repaired, @intact already intact, @skipped without an icon, @failed failed.', [
    '@repaired' => count($result['repaired']),
    '@intact' => count($result['intact']),
    '@skipped' => count($result['skipped']),
    '@failed' => count($result['failed']),
  ]);
}
